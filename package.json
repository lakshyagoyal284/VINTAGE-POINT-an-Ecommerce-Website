{
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "serve": "^14.2.4"
  },
  "scripts": {
    "build": "npx tailwindcss -i ./src/style.css -o ./dist/style.css",
